<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wherelee</groupId>
        <artifactId>ctry-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>ctry-app</artifactId>
    <name>ctry-app（网课垂直应用）</name>

    <dependencies>
        <dependency>
            <groupId>com.wherelee</groupId>
            <artifactId>btry-platform</artifactId>
            <version>${btry.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wherelee</groupId>
            <artifactId>btry-contracts</artifactId>
            <version>${btry.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wherelee</groupId>
            <artifactId>btry-identity</artifactId>
            <version>${btry.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wherelee</groupId>
            <artifactId>btry-payment</artifactId>
            <version>${btry.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qcloud</groupId>
            <artifactId>cos_api</artifactId>
            <version>${cos.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 保留可复用普通 jar，另出可执行 jar（classifier=exec）供部署 -->
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
